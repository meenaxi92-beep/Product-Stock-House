        "language": "pythonNative",
        "pythonCode": "rows = _items\n\nknowledge = []\n\nfor item in rows:\n    data = item[\"json\"]\n\n    product = (\n        f\"Product ID: {data.get('Product_ID', '')}\\n\"\n        f\"Product Name: {data.get('Product_Name', '')}\\n\"\n        f\"Category: {data.get('Category', '')}\\n\"\n        f\"Material: {data.get('Material', '')}\\n\"\n        f\"City: {data.get('City', '')}\\n\"\n        f\"Stock Quantity: {data.get('Stock_Qty', '')}\\n\"\n        f\"Unit Price: {data.get('Unit_Price', '')}\\n\"\n        f\"Sales Quantity: {data.get('Sales_Qty', '')}\\n\"\n        f\"Supplier: {data.get('Supplier', '')}\\n\"\n        f\"Stock Status: {data.get('Stock_Status', '')}\"\n    )\n\n    knowledge.append(product)\n\nknowledge_text = \"\\n\\n--- PRODUCT ---\\n\\n\".join(knowledge)\n\nreturn [\n    {\n        \"json\": {\n            \"source\": \"Knowledge Base\",\n            \"knowledge\": knowledge_text,\n            \"total_products\": len(rows)\n        }\n    }\n]"
